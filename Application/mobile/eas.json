{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.0.74:8000",
        "EXPO_PUBLIC_TEAM_ASSET_BASE_URL": "http://10.0.0.74:3000"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.nutritionell.com",
        "EXPO_PUBLIC_TEAM_ASSET_BASE_URL": "https://staging-web.nutritionell.com"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.nutritionell.com",
        "EXPO_PUBLIC_TEAM_ASSET_BASE_URL": "https://www.nutritionell.com"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
